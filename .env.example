# Copy to .env and fill in. .env is gitignored.

# YouTube Data API v3 key - enables discovery.source: youtube_api.
# Create at https://console.cloud.google.com/apis/credentials after enabling
# "YouTube Data API v3". Free tier is 10,000 quota units/day; one full discovery
# run costs roughly 100-200 units.
YOUTUBE_API_KEY=

# Twitch Helix API credentials - enables discovery.source: twitch.
# Register an app at https://dev.twitch.tv/console/apps/create then copy the
# Client ID and generate a Client Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Instagram / third-party discovery API key.
# Only needed when instagram.backend is set to a third-party service such as
# Apify. For the manual file backend, leave this blank.
INSTAGRAM_API_KEY=
